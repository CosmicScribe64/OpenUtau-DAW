diff --git a/OpenUtau.Test/Core/Api/PhonemizerRunnerTest.cs b/OpenUtau.Test/Core/Api/PhonemizerRunnerTest.cs
new file mode 100644
index 0000000..a135bfc
--- /dev/null
+++ b/OpenUtau.Test/Core/Api/PhonemizerRunnerTest.cs
@@ -0,0 +1,69 @@
+using System;
+using OpenUtau.Api;
+using OpenUtau.Core.Ustx;
+using Xunit;
+
+namespace OpenUtau.Core.Api {
+    public class PhonemizerRunnerTest {
+        [Fact]
+        public void UsesProjectAndTrackCapturedWithRequest() {
+            var project = new UProject();
+            var track = project.tracks[0];
+            var phonemizer = new ContextPhonemizer();
+            var request = new PhonemizerRequest {
+                singer = USinger.CreateMissing("test"),
+                part = new UVoicePart { trackNo = 99 },
+                project = project,
+                track = track,
+                timestamp = 1,
+                noteIndexes = new[] { 0 },
+                notes = new[] {
+                    new[] {
+                        new Phonemizer.Note {
+                            lyric = "test",
+                            tone = 60,
+                            position = 0,
+                            duration = 480,
+                            phonemeAttributes = Array.Empty<Phonemizer.PhonemeAttributes>(),
+                        },
+                    },
+                },
+                phonemizers = new Phonemizer[] { phonemizer },
+                notePhonemizerIndices = new[] { 0 },
+                timeAxis = project.timeAxis.Clone(),
+            };
+
+            var response = PhonemizerRunner.Phonemize(request);
+
+            Assert.Same(project, phonemizer.Project);
+            Assert.Same(track, phonemizer.Track);
+            Assert.Equal("ok", response.phonemes[0][0].phoneme);
+            Assert.Null(response.phonemes[0][0].error);
+        }
+
+        private sealed class ContextPhonemizer : Phonemizer {
+            public UProject Project { get; private set; }
+            public UTrack Track { get; private set; }
+
+            public override void SetSinger(USinger singer) { }
+
+            public override void SetUp(Note[][] notes, UProject project, UTrack track) {
+                base.SetUp(notes, project, track);
+                Project = project;
+                Track = track;
+            }
+
+            public override Result Process(
+                    Note[] notes,
+                    Note? prev,
+                    Note? next,
+                    Note? prevNeighbour,
+                    Note? nextNeighbour,
+                    Note[] prevs) {
+                return new Result {
+                    phonemes = new[] { new Phoneme { phoneme = "ok" } },
+                };
+            }
+        }
+    }
+}
