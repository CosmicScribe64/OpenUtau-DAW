diff --git a/OpenUtau.Core/Render/VstRenderAdapter.cs b/OpenUtau.Core/Render/VstRenderAdapter.cs
new file mode 100644
index 0000000..836c41b
--- /dev/null
+++ b/OpenUtau.Core/Render/VstRenderAdapter.cs
@@ -0,0 +1,45 @@
+using System;
+using System.Threading;
+using System.Threading.Tasks;
+using OpenUtau.Core.Ustx;
+
+namespace OpenUtau.Core.Render {
+    public static class VstRenderAdapter {
+        public const int SampleRate = 44100;
+        public const int Channels = 2;
+
+        public static void PrepareProject(UProject project) {
+            if (project == null) throw new ArgumentNullException(nameof(project));
+            project.Validate(new ValidateOptions {
+                SynchronousPhonemizer = true,
+            });
+        }
+
+        public static float[] RenderFrames(
+                UProject project, long startFrame, int frameCount,
+                CancellationToken cancellationToken = default,
+                bool prepareProject = true) {
+            if (project == null) throw new ArgumentNullException(nameof(project));
+            if (startFrame < 0) throw new ArgumentOutOfRangeException(nameof(startFrame));
+            if (frameCount < 0) throw new ArgumentOutOfRangeException(nameof(frameCount));
+            if (frameCount == 0) return Array.Empty<float>();
+            if (prepareProject) PrepareProject(project);
+            var startMs = startFrame * 1000.0 / SampleRate;
+            var endMs = (startFrame + frameCount) * 1000.0 / SampleRate;
+            var startTick = project.timeAxis.MsPosToTickPos(startMs);
+            var endTick = project.timeAxis.MsPosToTickPos(endMs) + 1;
+            CancellationTokenSource renderCancellation = null;
+            using var cancellationRegistration = cancellationToken.Register(
+                () => Volatile.Read(ref renderCancellation)?.Cancel());
+            var renderer = new RenderEngine(
+                project, startTick, endTick, notifications: false);
+            var (mix, _) = renderer.RenderMixdown(
+                TaskScheduler.Default, ref renderCancellation, wait: true);
+            cancellationToken.ThrowIfCancellationRequested();
+            var result = new float[checked(frameCount * Channels)];
+            var samplePosition = checked((int)(startFrame * Channels));
+            mix.Mix(samplePosition, result, 0, result.Length);
+            return result;
+        }
+    }
+}
